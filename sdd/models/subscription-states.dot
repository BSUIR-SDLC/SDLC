// Представление 007-state: состояния подписки
digraph states {
  graph [rankdir=LR, fontname="Liberation Sans", nodesep=0.6, ranksep=1.0, pad=0.2];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="#dbe8f7", color="#2f6db3"];
  edge  [fontname="Liberation Sans", fontsize=8, color="#555555"];
  start [shape=circle, label="", width=0.2, style=filled, fillcolor=black];
  end   [shape=doublecircle, label="", width=0.15, style=filled, fillcolor=black];
  trial  [label="Активна, пробный период\n(trial_end_date ≥ сегодня)\nне входит в суммы"];
  active [label="Активна\nвходит в суммы, напоминания,\nотметки использования"];
  paused [label="Приостановлена\nне входит в суммы,\nбез напоминаний"];
  cancelled [label="Отменена\nтолько в истории\nи аналитике"];

  start -> trial  [label="добавить с датой\nокончания пробного периода"];
  start -> active [label="добавить"];
  trial -> active [label="наступила trial_end_date\n[ежедневная задача 00:05]"];
  active -> active [label="наступила next_charge_date /\nnext_charge_date += период"];
  active -> paused [label="приостановить"];
  paused -> active [label="возобновить /\nnext_charge_date ≥ сегодня"];
  trial -> cancelled [label="отменить"];
  active -> cancelled [label="отменить"];
  paused -> cancelled [label="отменить"];
  cancelled -> end [label="удалить"];
  active -> end [label="удалить"];
}
