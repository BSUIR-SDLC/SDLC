@startuml
left to right direction
skinparam packageStyle rectangle

actor "Оператор / QA-инженер" as Operator
actor "Движок правил (Rule Engine)" as RuleEngine
actor "Таймер планировщика" as Timer

rectangle "IoT Device Emulator (Вариант 8)" {
  usecase "UC-1: Конфигурирование и запуск\nэмулятора через CLI" as UC1
  usecase "UC-2: Периодическая генерация\nJSON-телеметрии" as UC2
  usecase "UC-3: Приём и обработка\nкоманды /command" as UC3
  usecase "UC-4: Валидация Bearer-токена" as UC4
  usecase "UC-5: Динамическое изменение\nинтервала опроса (N)" as UC5
  usecase "UC-6: Мутация внутреннего\nсостояния сенсора" as UC6
  usecase "UC-7: Структурированное\nлогирование событий" as UC7
}

Operator --> UC1
Timer --> UC2
RuleEngine --> UC3

UC3 ..> UC4 : <<include>>
UC5 ..> UC3 : <<extend>>
UC6 ..> UC3 : <<extend>>
UC2 ..> UC7 : <<include>>
UC3 ..> UC7 : <<include>>
@enduml
