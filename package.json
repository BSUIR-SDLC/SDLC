{
  "name": "qrgate",
  "version": "0.1.0",
  "private": true,
  "description": "QRGate — контроль доступа по QR-пропускам",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "uml": "python tools/uml_render.py"
  }
}
