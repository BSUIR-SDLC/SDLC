// Диаграмма состояний 1: подписка (UC-04…UC-07, UC-11, UC-22; REQ-FUNC-007, REQ-FUNC-017)
digraph sm1 {
  graph [rankdir=TB, fontname="Liberation Sans", fontsize=11, nodesep=0.5, ranksep=0.7, pad=0.3, compound=true, newrank=true];
  node  [fontname="Liberation Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="#dbe8f7", color="#2f6db3", height=0.5];
  edge  [fontname="Liberation Sans", fontsize=9, color="#333333", arrowhead=vee, arrowsize=0.7];

  init  [shape=circle, style=filled, fillcolor=black, color=black, label="", width=0.2, height=0.2];
  final [shape=doublecircle, style=filled, fillcolor=black, color=black, label="", width=0.13, height=0.13];

  subgraph cluster_active {
    label=<<b>Активна</b>>; style="rounded,filled"; fillcolor="#f3f7fc"; color="#2f6db3";
    a_init [shape=circle, style=filled, fillcolor=black, color=black, label="", width=0.16, height=0.16];
    choice [shape=diamond, style=filled, fillcolor=white, label="", width=0.28, height=0.28];
    trial  [label=<<b>Пробный период</b><br/><font point-size="9">не входит в суммы;<br/>показывается в ближайших<br/>списаниях</font>>];
    paid   [label=<<b>Платная</b><br/><font point-size="9">входит в суммы, напоминания<br/>и отметки использования</font>>];
    a_init -> choice;
    choice -> trial [label="[trial_end_date ≥ сегодня]"];
    choice -> paid  [label="[иначе]"];
    trial -> paid   [label="наступила\ntrial_end_date"];
    paid -> paid    [label="наступила next_charge_date /\nсохранить списание,\nnext_charge_date += период (UC-22)"];
  }

  paused    [label=<<b>Приостановлена</b><br/><font point-size="9">не входит в суммы,<br/>без напоминаний</font>>];
  cancelled [label=<<b>Отменена</b><br/><font point-size="9">только история и аналитика;<br/>возобновить нельзя</font>>];

  init -> a_init [lhead=cluster_active, label="добавить (UC-04)"];
  paid -> paused [ltail=cluster_active, label="приостановить (UC-07)"];
  paused -> a_init [lhead=cluster_active, label="возобновить [новая дата ≥ сегодня] /\nnext_charge_date := новая дата", constraint=false];
  paid -> cancelled [ltail=cluster_active, label="отметить отменённой\n(UC-07, UC-11)"];
  paused -> cancelled [label="отметить\nотменённой (UC-07)"];
  paused -> final [label="удалить (UC-06)"];
  cancelled -> final [label="удалить (UC-06)"];
  trial -> final [ltail=cluster_active, label="удалить (UC-06)", constraint=false];
}
