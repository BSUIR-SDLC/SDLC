@startuml activity-import-csv
' Диаграмма активности: импорт пропусков из CSV (UC-11, расширяет UC-04)
' Связи: шаги = потоки UC-11 (uml/use-cases.md); проверки строк = BR-02, BR-03, SUP-I-02;
' каждый созданный пропуск попадает в состояние «Ожидает начала» или «Активен» (state-pass-lifecycle.puml)
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ActivityBackgroundColor #F4F8FC
skinparam ActivityBorderColor #2F5D8A
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #2F5D8A
skinparam SwimlaneTitleFontStyle bold

title Импорт пропусков из CSV (UC-11)

|Администратор|
start
:Открыть «Пропуска → Импорт»;
:Выбрать файл CSV;

|Панель администратора|
if (Размер ≤ 2 МБ и расширение .csv?) then (нет)
  :Показать «Неверный файл»;
  stop
else (да)
endif
:POST /api/v1/passes/import;

|Сервер|
if (Кодировка UTF-8 и заголовок\nfio;type;email;valid_from;valid_to;zones?) then (нет)
  :Ответ 400 «Неверный формат файла»;
  |Панель администратора|
  :Показать ошибку и образец файла;
  stop
else (да)
endif
|Сервер|
:Создать отчёт импорта;
while (Есть необработанная строка?) is (да)
  :Разобрать строку;
  if (Поля заполнены, тип P/G,\nсрок по BR-03, зоны существуют?) then (да)
    if (Владелец с таким e-mail уже есть?) then (да)
      :Связать пропуск\nс существующим владельцем;
    else (нет)
      :Создать владельца;
    endif
    :Выпустить пропуск: номер по BR-02,\nversion = 1, статус по valid_from;
    :Добавить в отчёт «создан»;
  else (нет)
    :Добавить в отчёт ошибку\nс номером строки и полем;
  endif
endwhile (нет)
:Зафиксировать транзакцию\nи запись аудита (SUP-F-01);
:Ответ 200 {created, errors[]};

|Панель администратора|
:Показать отчёт: создано N,\nошибок M со списком строк;
if (Есть ошибки?) then (да)
  |Администратор|
  :Скачать отчёт об ошибках,\nисправить файл;
else (нет)
endif
|Администратор|
:Скачать QR созданных пропусков\n(архив PNG) для печати;
stop
@enduml
