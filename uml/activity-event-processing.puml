@startuml activity-event-processing
' AD-01. Обработка события безопасности: от хоста до консоли (прецедент UC-09)
skinparam shadowing false
skinparam defaultFontName Arial
title AD-01. Обработка события безопасности (UC-09)

|Агент|
start
:Событие ОС получено<
note right
  Сигнал от журнала безопасности
  Windows или от системы USB
end note
:Привести событие к единому формату;
:Положить событие в очередь на диске;
repeat
  :Отправить пачку событий по mTLS>
  backward:Подождать и повторить;
repeat while (Подтверждение Ack получено?) is ([нет]) not ([да])
:Удалить пачку из очереди;
end

|Сервер|
:Пачка событий принята<
if (Номер пачки уже принят?) then ([да])
  :Ответить Ack без сохранения>
  end
else ([нет])
  :Сохранить события в базе;
  :Ответить Ack>
endif

|Движок обнаружения|
:Найти правила, подходящие к событию;
while (Есть непроверенное правило?) is ([да])
  :Добавить событие в окно правила;
  :Удалить из окна события старше окна;
  if (Событий в окне не меньше порога?) then ([да])
    if (Открытый инцидент по правилу и хосту есть?) then ([да])
      :Дописать событие в инцидент;
    else ([нет])
      :Определить важность по правилу;
      if (Помещение режимное?) then ([да])
        :Повысить важность на один уровень;
      else ([нет])
      endif
      :Создать инцидент и связать с событиями;
    endif
    fork
      :Пересчитать состояние хоста;
    fork again
      :Сохранить инцидент в базе;
    end fork
    |Сервер|
    :Разослать incident_new и host_state>
    |Движок обнаружения|
  else ([нет])
  endif
endwhile ([нет])
stop
@enduml
