@startuml
skinparam defaultFontName "GOST type B"
skinparam defaultFontSize 12
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
start
repeat
 :Ввести данные для входа;
 if (Учётные данные верны?) then (нет)
  :Показать ошибку входа;
 endif
repeat while (Учётные данные неверны?) is (да) not (нет)
:Открыть личный список задач;
repeat
 :Ввести название, приоритет,
дедлайн и категорию;
 if (Данные корректны?) then (нет)
  :Показать ошибки заполнения;
 endif
repeat while (Данные некорректны?) is (да) not (нет)
:Сохранить новую задачу;
if (Нужны подзадачи?) then (да)
 :Добавить подзадачи;
endif
if (Нужно повторение?) then (да)
 :Настроить расписание повторения;
endif
:Найти задачу с помощью поиска и фильтров;
if (Нужны изменения?) then (да)
 :Изменить данные задачи
и сохранить после проверки;
endif
:Выполнить дело и отметить
задачу завершённой;
if (Есть повторение?) then (да)
 :Создать следующий экземпляр
задачи с новым сроком;
endif
stop
@enduml
